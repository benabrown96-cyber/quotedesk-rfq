# QuoteDesk — Environment Variables
# Copy this file to .env for local development.
# On Railway, set these in the Variables tab of your service.

# ─── Required ────────────────────────────────────────────────
# Port Railway will use (Railway sets this automatically — do not change)
PORT=5000

# Node environment
NODE_ENV=production

# Path for the SQLite database file (used in demo mode)
# On Railway, data persists in a Volume — mount at /app/data
DATABASE_PATH=/app/data/data.db

# ─── Production: Postgres (replace SQLite when ready) ────────
# Uncomment and fill in when you switch to Azure PostgreSQL or Railway Postgres
# DATABASE_URL=postgresql://user:password@host:5432/quotedesk

# ─── Production: Microsoft Entra ID (staff login) ────────────
# Get these from your Azure App Registration
# AAD_TENANT_ID=your-tenant-id
# AAD_CLIENT_ID=your-client-id
# AAD_CLIENT_SECRET=your-client-secret
# SESSION_SECRET=a-long-random-string-at-least-32-chars

# ─── Production: Microsoft Graph (email notifications) ───────
# MS_GRAPH_TENANT_ID=your-tenant-id
# MS_GRAPH_CLIENT_ID=your-client-id
# MS_GRAPH_CLIENT_SECRET=your-client-secret
# MS_GRAPH_FROM_ADDRESS=noreply@theexpertsgroup.onmicrosoft.com

# ─── Production: Azure Blob Storage (document uploads) ───────
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...
# AZURE_STORAGE_CONTAINER=quotedesk-documents
